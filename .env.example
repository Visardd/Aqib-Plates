# Public URL of the live site (used for canonical URLs, sitemap and structured data)
NEXT_PUBLIC_SITE_URL=https://www.aqibplates.com

# Sanity (plate admin). Leave empty to run on the seed data in src/data/seed-plates.json
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Secret shared with the Sanity webhook that refreshes plate pages after an edit
SANITY_REVALIDATE_SECRET=
# Editor token: used to import the seed plates, reserve plates during checkout and mark them sold
SANITY_API_WRITE_TOKEN=

# Stripe (payments). Without a secret key, Buy Now falls back to the contact form
STRIPE_SECRET_KEY=
# Signing secret of the webhook pointing at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Resend (form emails). Without a key, form submissions are logged instead of emailed
RESEND_API_KEY=
EMAIL_FROM="Aqib Plates <hello@aqibplates.com>"
OWNER_EMAIL=aqibplates@gmail.com

# Google Search Console verification token
GOOGLE_SITE_VERIFICATION=
